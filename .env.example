# NextGen Learning — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local dev, and add the same values in
# your Vercel project settings ("Environment Variables") for production.
# Never commit a real .env.local file.
# ---------------------------------------------------------------------------

# --- Email delivery (REQUIRED for Contact/Register/Volunteer to work) ----
# 1. Go to https://resend.com and sign up free (3,000 emails/mo, no card).
# 2. Dashboard → API Keys → Create API Key → copy it here.
RESEND_API_KEY=""

# Leave this as-is until you verify your own domain in Resend. Using an
# unverified custom domain as the sender will cause emails to fail.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Everything below is OPTIONAL — only needed if/when you add these ----

# Supabase (database + storage), for a real registrations/volunteers table
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Clerk (authentication), for future student/tutor/admin dashboards
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Google Calendar (session scheduling automation)
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""
